{
  "expo": {
    "name": "Alumni Network Portal",
    "slug": "alumni-network-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.institution.alumninetwork",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0dbfb3f4-098b-4c17-b88d-b92ef2a3f850"
      }
    }
  }
}
